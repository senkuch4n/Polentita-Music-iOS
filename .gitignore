# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Sideload build output (scripts/build-ipa.sh)
/build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Private keys / certs — but NOT the vendored Python CA bundles & test fixtures,
# which ship with Python.xcframework and are needed to build / make HTTPS calls.
*.pem
!ios/Python.xcframework/**/*.pem
!ios/PythonApp/**/*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# ios/ IS committed (bare workflow -- custom native modules live here from
# step 4 onward), only build output and Pods are excluded. Android isn't
# targeted from this repo (see project plan).
/android
/ios/Pods/
/ios/build/
/ios/DerivedData/
/ios/*.xcworkspace/xcuserdata/
/ios/*.xcodeproj/xcuserdata/
/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
